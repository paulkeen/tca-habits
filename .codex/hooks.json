{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 .codex/hooks/guard_streak.py",
            "statusMessage": "Checking streak-logic guardrail",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "make -s -C \"$(git rev-parse --show-toplevel)\" check",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
